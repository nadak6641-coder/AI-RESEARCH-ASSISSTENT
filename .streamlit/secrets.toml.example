# Streamlit secrets template
# ------------------------------------------------------------------
# Locally:  copy this file to secrets.toml and add your real key
#           (the real secrets.toml is protected by .gitignore)
# On Cloud: open the app, then Manage app > Secrets, and paste this
#           content with your real key
# ------------------------------------------------------------------

OPENROUTER_API_KEY = "your_openrouter_key_here"
OPENROUTER_MODEL = "openai/gpt-4o-mini"
